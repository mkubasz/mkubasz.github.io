---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog">
  <h1>Blog</h1>

  <p>
    Notes on AI, data, and software architecture. Posts marked <span class="badge">notebook</span> are
    <a href="https://marimo.io/">marimo</a> notebooks published with
    <a href="https://marimo-team.github.io/marimo-studio/">marimo-studio</a>: the figures are computed
    in Python and stay interactive.
  </p>

  <table class="post-index">
    <thead>
      <tr><th>Date</th><th>Post</th></tr>
    </thead>
    <tbody>
      {posts.map((post) => (
        <tr>
          <td>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </td>
          <td>
            <b><a href={`/blog/${post.slug}/`}>{post.data.title}</a></b>
            {post.data.notebook && <span class="badge">notebook</span>}
            {post.data.excerpt && <br />}
            {post.data.excerpt}
            {post.data.tags && post.data.tags.length > 0 && (
              <div>{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</BaseLayout>
