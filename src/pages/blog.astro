---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog">
  <h1>Technical Blog</h1>

  <p>
    Insights, experiences, and best practices from over 13 years of building scalable systems,
    implementing AI solutions, and leading engineering teams.
  </p>

  <div class="topics-grid">
    <div class="topic-card">
      <h3>🤖 AI & ML</h3>
      <p>LLM integration, Agent AI, MLOps, and Prompt Engineering</p>
    </div>

    <div class="topic-card">
      <h3>☁️ Cloud</h3>
      <p>Serverless, Multi-Cloud, FinOps, and Infrastructure as Code</p>
    </div>

    <div class="topic-card">
      <h3>📊 Data</h3>
      <p>Pipelines, Streaming, Analytics, and Data Quality</p>
    </div>

    <div class="topic-card">
      <h3>🏗️ Architecture</h3>
      <p>Event-Driven, DDD, Microservices, and CQRS/ES</p>
    </div>

    <div class="topic-card">
      <h3>👥 Leadership</h3>
      <p>Team Building, Strategy, Mentorship, and Culture</p>
    </div>
  </div>

  <hr />

  <h2>Recent Posts</h2>

  <div class="blog-posts">
    {posts.map((post) => (
      <article class="card">
        <h3>
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </h3>

        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>

          {post.data.categories && post.data.categories.length > 0 && (
            <span class="post-categories">
              {post.data.categories.map(category => (
                <span class="category">{category}</span>
              ))}
            </span>
          )}
        </div>

        {post.data.excerpt && (
          <p>{post.data.excerpt}</p>
        )}

        <a href={`/blog/${post.slug}`} class="btn-secondary">Read More</a>
      </article>
    ))}
  </div>

  <div class="cta-section">
    <h3>Want to Discuss a Topic?</h3>
    <p>Have a question or suggestion for a blog post? I'd love to hear from you!</p>
    <a href="/about#contact" class="btn-primary">Get in Touch</a>
  </div>
</BaseLayout>
